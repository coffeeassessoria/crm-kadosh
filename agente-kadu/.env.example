# ============================================================
#  Agente Kadu — Variáveis de Ambiente
#  Copie este arquivo para ".env" e preencha com os valores reais.
#  NUNCA commite o arquivo ".env" (já está no .gitignore).
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- LLM (Anthropic Claude) ---
# Crie a chave em https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-COLOQUE_SUA_CHAVE_AQUI
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Transcrição de áudio (opcional, RF01.4) ---
# Sem essa chave, o agente pede para o cliente escrever a mensagem.
OPENAI_API_KEY=sk-proj-COLOQUE_SUA_CHAVE_AQUI

# --- Supabase (mesmo projeto do CRM) ---
# Settings > API no painel do Supabase. Use a SERVICE ROLE KEY (NUNCA a anon key) —
# ela ignora RLS e permite o agente criar/editar leads, agendamentos, etc.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLOQUE_A_SERVICE_ROLE_KEY_AQUI

# --- WhatsApp (Evolution API) ---
# URL base do seu servidor Evolution API (mesma do painel /manager)
EVOLUTION_API_URL=https://SEU_SERVIDOR_EVOLUTION
# API Key (global do servidor ou específica da instância) — enviada no header "apikey"
EVOLUTION_API_KEY=COLOQUE_A_API_KEY
# Nome da instância conectada ao número da Kadosh
EVOLUTION_INSTANCE=COLOQUE_O_NOME_DA_INSTANCIA
# Segredo aleatório usado na URL do webhook: /webhook/whatsapp/<este_valor>
# Gere um valor com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET=COLOQUE_UM_SEGREDO_ALEATORIO

# ID do grupo operacional que recebe o briefing diário (formato: NUMERO@g.us)
WHATSAPP_GRUPO_OPERACIONAL_ID=COLOQUE_O_ID_DO_GRUPO@g.us

# --- Google Agenda (Service Account) ---
# Opcional no início: sem isso, os agendamentos são criados só no CRM.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary

# --- Regras de negócio (RNF03.3 — tudo configurável sem alterar código) ---
# Valor da diária padrão por caçamba (inclui entrega, 1 dia de permanência e retirada)
PRECO_LOCACAO=250
# Valor cobrado por dia extra de permanência da caçamba, por caçamba
DIARIA_ADICIONAL=25
# Chave PIX para cobrança do sinal de 50% (RF04)
CHAVE_PIX=6696585048

# Horário do briefing diário (formato cron, padrão 06h30 todos os dias)
HORARIO_BRIEFING_CRON=30 6 * * *
TIMEZONE=America/Cuiaba

# Janela de horário comercial para entregas
HORARIO_COMERCIAL_INICIO=07:30
HORARIO_COMERCIAL_FIM=18:00

# --- Agente Administrativo/Financeiro (grupo operacional) ---
# Nome de exibição usado no system prompt do segundo agente (consultas de agenda,
# financeiro e funil de leads dentro do grupo operacional).
AGENTE_ADMIN_NOME=Kadu Financeiro
# Palavra-gatilho (case-insensitive, busca por palavra) que aciona o agente
# administrativo quando alguém escreve no grupo operacional. Ex: "Kadu, agenda de hoje?"
AGENTE_ADMIN_TRIGGER=kadu

# --- Segurança (RNF01.4) ---
RATE_LIMIT_MAX_PER_MINUTE=10
